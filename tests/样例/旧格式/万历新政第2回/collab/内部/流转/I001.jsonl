{"v": 1, "seq": 3, "项目序": 35, "时间": "1573-03-03T10:10:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "工部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "主束水攻沙：堤成则沙自去，一劳永逸；分流则河道日浅，十年后复决。"}
{"v": 1, "seq": 4, "项目序": 36, "时间": "1573-03-03T10:14:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "户部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "分流工省银少，今年即可见效；束水攻沙需银倍之，恐难支应。"}
{"v": 1, "seq": 5, "项目序": 37, "时间": "1573-03-03T10:18:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "都察院", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "前朝分流屡试屡决，先例不利；束水攻沙需严查堤工，防偷工减料。"}
{"v": 1, "seq": 6, "项目序": 38, "时间": "1573-03-03T10:22:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "总裁", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "看板", "点名": ["工部", "户部"], "正文": "@工部 @户部 各执一词。工部说分流十年复决，户部说束水银不够，互相驳来。"}
{"v": 1, "seq": 7, "项目序": 39, "时间": "1573-03-03T10:26:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "户部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "@工部 束水攻沙估银八十万两，户部今年至多拨四十万，余下的从何处出？"}
{"v": 1, "seq": 8, "项目序": 40, "时间": "1573-03-03T10:30:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "工部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "@户部 分流省的是今年的银，十年后复决再堵，所费何止八十万？嘉靖年间三次分流，三次复决。"}
{"v": 1, "seq": 9, "项目序": 41, "时间": "1573-03-03T10:34:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "都察院", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "@户部 工部所举嘉靖旧案属实；分流省下的银，终要加倍还。"}
{"v": 1, "seq": 10, "项目序": 42, "时间": "1573-03-03T10:38:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "总裁", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "看板", "点名": ["工部"], "正文": "@工部 户部今年只有四十万两。束水攻沙能不能缓一步，先办今年要紧的？"}
{"v": 1, "seq": 11, "项目序": 43, "时间": "1573-03-03T10:42:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "工部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "可退一步：今年先堵口、筑缕堤，银二十四万；遥堤明年再筑。险段另开减水坝，汛期泄洪，兼取分流之长。"}
{"v": 1, "seq": 12, "项目序": 44, "时间": "1573-03-03T10:46:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "户部", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "如此今年二十四万两，户部支应得来；明年遥堤之银另行筹措，赞成。"}
{"v": 1, "seq": 13, "项目序": 45, "时间": "1573-03-03T10:50:00+08:00", "对象": "I001", "骨架": "议题@1", "边": "发言", "发起": "都察院", "接收": "无", "前状态": "讨论中", "后状态": "讨论中", "写入者": "派活脚本", "正文": "折中可行，无新异议。堤分两年筑，偷减易出在后一年，请巡按专核堤工。"}
