{
  "骨架": "目标",
  "版本": 1,
  "说明": "目标级状态机。阶段进度不记事件，由下属任务推出；阶段实例记在「提交」「批准」「变更」事件的「阶段」字段里。",
  "初始": "起草",
  "终止": ["完成", "取消"],
  "类型": ["通用", "调研", "开发"],
  "状态": {
    "起草": {"类别": "待办", "持有": "总管"},
    "待批准": {"类别": "评审", "持有": "总裁"},
    "进行中": {"类别": "进行", "持有": "总管"},
    "待确认": {"类别": "评审", "持有": "总裁"},
    "暂停": {"类别": "待办", "持有": "总管"},
    "完成": {"类别": "完成"},
    "取消": {"类别": "完成"}
  },
  "边": {
    "建立": {"从": ["无"], "到": "起草", "发起": "管理", "接收": "总管", "必填": ["依据"]},
    "提交": {"从": ["起草"], "到": "待批准", "发起": "总管", "接收": "总裁", "必填": ["说明"]},
    "退回": {"从": ["待批准"], "到": "起草", "发起": "总裁", "接收": "总管", "必填": ["说明"]},
    "批准": {"从": ["待批准"], "到": "进行中", "发起": "总裁", "接收": "总管", "必填": ["依据"]},
    "目标验收": {"从": ["进行中"], "到": "待确认", "发起": "总管", "接收": "总裁", "必填": ["说明", "方案", "建议"]},
    "完成": {"从": ["待确认"], "到": "完成", "发起": "总裁", "接收": "无", "必填": ["依据"]},
    "打回": {"从": ["待确认"], "到": "进行中", "发起": "总裁", "接收": "总管", "必填": ["说明"]},
    "暂停": {"从": ["起草", "待批准", "进行中", "待确认"], "到": "暂停", "发起": "管理", "接收": "总管", "必填": ["说明"]},
    "恢复": {"从": ["暂停"], "到": "@暂停前状态", "发起": "管理", "接收": "@暂停前持有人"},
    "取消": {"从": ["起草", "待批准", "进行中", "待确认", "暂停"], "到": "取消", "发起": "管理", "接收": "无", "必填": ["说明"]}
  },
  "特殊事件": {
    "变更": {"必填": ["说明", "变更项"], "要批准的变更项": ["目标", "成功标准", "硬约束", "验收结构"]},
    "进展": {"必填": []},
    "更正": {"必填": ["更正", "说明"]}
  }
}
