{
  "skeleton": "goal",
  "version": 1,
  "description": "Goal state machine. Stage progress is not an event: it is derived from the tasks. Stage instances are recorded in the stage field of submit, approve and change events.",
  "initial": "draft",
  "terminal": ["done", "cancelled"],
  "types": ["general", "research", "dev"],
  "states": {
    "draft": {"category": "todo", "holder": "lead"},
    "pending_approval": {"category": "review", "holder": "owner"},
    "active": {"category": "doing", "holder": "lead"},
    "pending_acceptance": {"category": "review", "holder": "owner"},
    "paused": {"category": "todo", "holder": "lead"},
    "done": {"category": "done"},
    "cancelled": {"category": "done"}
  },
  "edges": {
    "create": {"from": ["none"], "to": "draft", "initiator": "manager", "receiver": "lead", "required": ["basis"]},
    "submit": {"from": ["draft"], "to": "pending_approval", "initiator": "lead", "receiver": "owner", "required": ["note"]},
    "return": {"from": ["pending_approval"], "to": "draft", "initiator": "owner", "receiver": "lead", "required": ["note"]},
    "approve": {"from": ["pending_approval"], "to": "active", "initiator": "owner", "receiver": "lead", "required": ["basis"]},
    "request_acceptance": {"from": ["active"], "to": "pending_acceptance", "initiator": "lead", "receiver": "owner", "required": ["note", "options", "recommendation"]},
    "complete": {"from": ["pending_acceptance"], "to": "done", "initiator": "owner", "receiver": "none", "required": ["basis"]},
    "reject": {"from": ["pending_acceptance"], "to": "active", "initiator": "owner", "receiver": "lead", "required": ["note"]},
    "pause": {"from": ["draft", "pending_approval", "active", "pending_acceptance"], "to": "paused", "initiator": "manager", "receiver": "lead", "required": ["note"]},
    "resume": {"from": ["paused"], "to": "@state_before_pause", "initiator": "manager", "receiver": "@holder_before_pause"},
    "cancel": {"from": ["draft", "pending_approval", "active", "pending_acceptance", "paused"], "to": "cancelled", "initiator": "manager", "receiver": "none", "required": ["note"]}
  },
  "special_events": {
    "change": {"required": ["note", "changes"], "changes_need_approval": ["目标", "成功标准", "硬约束", "验收结构"]},
    "progress": {"required": []},
    "correction": {"required": ["correct", "note"]}
  }
}
