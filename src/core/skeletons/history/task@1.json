{
  "skeleton": "task",
  "version": 1,
  "description": "Task state machine. Initiator and receiver are seat classes: holder, manager (lead or owner), lead, owner, executor, reviewer, self, none; those starting with @ are derived by replay.",
  "initial": "approved",
  "terminal": ["passed", "cancelled"],
  "max_rework": 3,
  "states": {
    "approved": {"category": "todo", "holder": "lead"},
    "dispatched": {"category": "todo", "holder": "executor"},
    "in_progress": {"category": "doing", "holder": "executor"},
    "in_review": {"category": "review", "holder": "reviewer"},
    "blocked": {"category": "doing", "holder": "manager"},
    "paused": {"category": "todo", "holder": "lead"},
    "failed": {"category": "review", "holder": "lead"},
    "passed": {"category": "done"},
    "cancelled": {"category": "done"}
  },
  "edges": {
    "create": {"from": ["none"], "to": "approved", "initiator": "manager", "receiver": "lead", "required": ["basis"]},
    "dispatch": {"from": ["approved"], "to": "dispatched", "initiator": "manager", "receiver": "executor"},
    "pick_up": {"from": ["dispatched"], "to": "in_progress", "initiator": "holder", "receiver": "self"},
    "deliver": {"from": ["in_progress"], "to": "in_review", "initiator": "holder", "receiver": "reviewer", "default_receiver": "lead", "required": ["evidence", "note"]},
    "review": {"from": ["in_review"], "initiator": "holder", "required": ["note"], "results": {
      "pass": {"to": "passed", "receiver": "none"},
      "needs_more": {"to": "in_progress", "receiver": "executor", "default_receiver": "@last_deliverer"},
      "fail": {"to": "failed", "receiver": "lead"}
    }},
    "hand_over": {"from": ["in_progress", "in_review", "blocked"], "to": "@unchanged", "initiator": "holder", "receiver": "@state_seat", "required": ["note"]},
    "escalate": {"from": ["approved", "dispatched", "in_progress", "in_review", "failed", "paused"], "to": "blocked", "initiator": "holder", "receiver": "manager", "default_receiver": "lead", "required": ["note"]},
    "unblock": {"from": ["blocked"], "to": "@state_before_escalation", "initiator": "manager", "receiver": "@holder_before_escalation"},
    "reassign": {"from": ["dispatched", "in_progress", "blocked", "failed"], "to": "dispatched", "initiator": "manager", "receiver": "executor", "required": ["note"]},
    "pause": {"from": ["approved", "dispatched", "in_progress", "in_review", "blocked", "failed"], "to": "paused", "initiator": "manager", "receiver": "lead", "required": ["note"]},
    "resume": {"from": ["paused"], "to": "@state_before_pause", "initiator": "manager", "receiver": "@holder_before_pause"},
    "reopen": {"from": ["passed"], "to": "dispatched", "initiator": "manager", "receiver": "executor", "required": ["note"]},
    "cancel": {"from": ["approved", "dispatched", "in_progress", "in_review", "blocked", "paused", "failed"], "to": "cancelled", "initiator": "manager", "receiver": "none", "required": ["note"]}
  },
  "special_events": {
    "change": {"required": ["note", "changes"]},
    "progress": {"required": []},
    "correction": {"required": ["correct", "note"]}
  }
}
