{
  "skeleton": "issue",
  "version": 1,
  "description": "Council (issue) state machine, proposal 03 section 10. One kind of council: the owner starts it, the lead drafts it, the owner starts the discussion once agreed; while discussing the owner chairs and only the owner's @ wakes members; the lead closes when told. post and PASS are message events and do not change the holder. Type review_meeting is a plan review attached to a goal pending approval; it is ruled together when the owner approves or returns that goal.",
  "initial": "draft",
  "terminal": ["ruled", "cancelled"],
  "types": ["council", "review_meeting"],
  "states": {
    "draft": {"category": "todo", "holder": "lead"},
    "discussing": {"category": "doing", "holder": "owner"},
    "closing": {"category": "doing", "holder": "lead"},
    "pending_ruling": {"category": "review", "holder": "owner"},
    "ruled": {"category": "done"},
    "cancelled": {"category": "done"}
  },
  "edges": {
    "create": {"from": ["none"], "to": "draft", "initiator": "manager", "receiver": "lead", "required": ["basis", "attendees"]},
    "start": {"from": ["draft"], "to": "discussing", "initiator": "owner", "receiver": "owner"},
    "end_discussion": {"from": ["discussing"], "to": "closing", "initiator": "owner", "receiver": "lead"},
    "continue_discussion": {"from": ["closing", "pending_ruling"], "to": "discussing", "initiator": "owner", "receiver": "owner"},
    "summarize": {"from": ["closing"], "to": "pending_ruling", "initiator": "lead", "receiver": "owner", "required": ["note", "options", "recommendation"]},
    "rule": {"from": ["pending_ruling"], "to": "ruled", "initiator": "owner", "receiver": "none", "required": ["basis", "note"]},
    "cancel": {"from": ["draft", "discussing", "closing", "pending_ruling"], "to": "cancelled", "initiator": "manager", "receiver": "none", "required": ["note"]}
  },
  "message_events": {
    "post": {"required": ["body"], "allowed_in": ["discussing"]},
    "pass": {"required": [], "allowed_in": ["discussing"]}
  },
  "special_events": {
    "change": {"required": ["note", "changes"]},
    "progress": {"required": []},
    "correction": {"required": ["correct", "note"]}
  }
}
