{
  "骨架": "议题",
  "版本": 1,
  "说明": "朝会（议题）状态机，方案 03 第 10 节。只有一种朝会：总裁发起、总管草拟，商定后总裁开始；讨论中由总裁主持，只有总裁的 @ 能叫醒成员，讨论完告诉总管收尾。发言、PASS 是消息事件，不改持有人。类型「会审」是挂在待批准目标上的框架会审，总裁批准或退回该目标时随之裁决。",
  "初始": "起草",
  "终止": ["已裁决", "取消"],
  "类型": ["朝会", "会审"],
  "状态": {
    "起草": {"类别": "待办", "持有": "总管"},
    "讨论中": {"类别": "进行", "持有": "总裁"},
    "收口中": {"类别": "进行", "持有": "总管"},
    "待裁决": {"类别": "评审", "持有": "总裁"},
    "已裁决": {"类别": "完成"},
    "取消": {"类别": "完成"}
  },
  "边": {
    "建立": {"从": ["无"], "到": "起草", "发起": "管理", "接收": "总管", "必填": ["依据", "与会"]},
    "开始": {"从": ["起草"], "到": "讨论中", "发起": "总裁", "接收": "总裁"},
    "结束讨论": {"从": ["讨论中"], "到": "收口中", "发起": "总裁", "接收": "总管"},
    "继续讨论": {"从": ["收口中", "待裁决"], "到": "讨论中", "发起": "总裁", "接收": "总裁"},
    "总结": {"从": ["收口中"], "到": "待裁决", "发起": "总管", "接收": "总裁", "必填": ["说明", "方案", "建议"]},
    "裁决": {"从": ["待裁决"], "到": "已裁决", "发起": "总裁", "接收": "无", "必填": ["依据", "说明"]},
    "取消": {"从": ["起草", "讨论中", "收口中", "待裁决"], "到": "取消", "发起": "管理", "接收": "无", "必填": ["说明"]}
  },
  "消息事件": {
    "发言": {"必填": ["正文"], "可在": ["讨论中"]},
    "PASS": {"必填": [], "可在": ["讨论中"]}
  },
  "特殊事件": {
    "变更": {"必填": ["说明", "变更项"]},
    "进展": {"必填": []},
    "更正": {"必填": ["更正", "说明"]}
  }
}
